/* The proxy/stub registration is written by hand rather than generated from
 * wbemprox_proxy.idl: that file has to #include wbemcli.idl to get at the
 * interface definitions, and widl would then also emit registry entries for
 * wbemcli's top-level coclasses - including classes wbemprox does not
 * implement, and one that wmiutils owns. Keep this in sync when the set of
 * proxied interfaces changes. */

/* @makedep: wbemprox_proxy.rgs */
1 WINE_REGISTRY wbemprox_proxy.rgs
